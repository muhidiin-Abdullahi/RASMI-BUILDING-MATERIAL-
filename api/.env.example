NODE_ENV=development
PORT=4001
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Required for runtime API + seed script (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/rbm_dev

INQUIRY_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_MAX=15

# Authentication (min 32 characters each; use cryptographically random values in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
# COOKIE_DOMAIN=

# One-time provisioning via npm run create-admin (never commit real values)
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_ROLE=SUPER_ADMIN
# FORCE_CREATE_ADMIN=true
